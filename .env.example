# Local PostgreSQL connection used by Docker Compose in M1.3.
DATABASE_URL=postgresql+psycopg://enterprise_agent:enterprise_agent@db:5432/enterprise_agent

# Select one configured LLM profile for a live demo.
LLM_PROFILE=openai

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Claude
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# OpenRouter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
